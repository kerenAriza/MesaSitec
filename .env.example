# Secreto usado para firmar los tokens JWT (HS256).
# En desarrollo, si no se define, la Api usa un valor de respaldo en appsettings.json.
JWT_SECRETO=

# Fecha base para generar los datos semilla de forma reproducible.
# Si no se define, se usa el valor por defecto: 2026-01-15T08:00:00Z
SEED_FECHA_BASE=
